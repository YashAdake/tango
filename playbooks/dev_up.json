{
  "id": "dev_up",
  "version": 1,
  "description": "Start a project's development environment and verify each layer.",
  "risk": "R1_REVERSIBLE",
  "params": {
    "project": {
      "type": "ProjectId",
      "required": true,
      "resolver": "resolve_project"
    },
    "_project": {
      "type": "Project",
      "required": true
    },
    "has_compose": {
      "type": "bool",
      "required": false,
      "default": false
    }
  },
  "steps": [
    {
      "id": "db",
      "tool": "docker.compose_up",
      "label": "Database",
      "when": "params.has_compose == true",
      "args": {
        "project_path": "${_project.compose_path}",
        "service": "${_project.compose_service}",
        "container": "${_project.container}"
      },
      "on_fail": "abort"
    },
    {
      "id": "dev",
      "tool": "process.start",
      "label": "Dev server",
      "args": {
        "cmd": "${_project.dev_cmd}",
        "cwd": "${_project.path}"
      },
      "on_fail": "continue"
    },
    {
      "id": "editor",
      "tool": "app.launch",
      "label": "Editor",
      "args": {
        "app": "vscode",
        "path": "${_project.path}"
      },
      "on_fail": "continue"
    }
  ],
  "compensate": [
    {
      "id": "down",
      "tool": "docker.compose_down",
      "label": "Database down",
      "args": {
        "project_path": "${_project.compose_path}",
        "container": "${_project.container}"
      }
    }
  ]
}
